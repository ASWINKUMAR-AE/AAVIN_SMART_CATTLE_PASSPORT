{
  "expo": {
    "name": "Aavin Smart Cattle Passport",
    "slug": "aavin-smart-cattle-passport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aavincattle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0072BC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aavin.smartcattlepassport",
      "infoPlist": {
        "NSCameraUsageDescription": "Aavin Smart Cattle Passport requires camera access to scan cow ear-tag QR codes and batch delivery tokens.",
        "NSLocationWhenInUseUsageDescription": "Location is used for recording milk batch transit dispatch and collection coordinates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0072BC"
      },
      "package": "com.aavin.smartcattlepassport",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan cow ear-tag QR codes"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
