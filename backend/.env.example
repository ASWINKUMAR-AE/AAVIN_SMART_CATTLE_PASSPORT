# Node Server Config
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# MySQL Database (XAMPP Default)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=aavin_milkflow
DATABASE_USER=root
DATABASE_PASSWORD=

# JWT Secrets (Generated for secure authentication)
JWT_ACCESS_SECRET=aavin_secret_access_token_jwt_2026_madurai_cow_dairy_key
JWT_REFRESH_SECRET=aavin_secret_refresh_token_jwt_2026_madurai_cow_dairy_refresh_key
ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=30d

# AI Service Configuration
# AI_PROVIDER can be 'openrouter' | 'own_api' | 'disabled'
AI_PROVIDER=openrouter
AI_ENABLED=true

# AI Fallback Configuration (MANDATORY: Disabled by default, never silent)
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=own_api

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Own AI API Configuration (Self-hosted or Private endpoint)
OWN_AI_BASE_URL=http://127.0.0.1:8000/v1
OWN_AI_API_KEY=own_dairy_ai_secure_token
OWN_AI_MODEL=dairy-llama-7b

# AI Limits
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
