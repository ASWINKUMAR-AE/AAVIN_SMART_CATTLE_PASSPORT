meta {
  name: 04 Login Farmer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{farmerPhone}}",
    "password": "{{farmerPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://127.0.0.1:8000/
  farmerPhone: 8056841005
  farmerPassword: framer01
}

script:pre-request {
  bru.setVar("farmerAccessToken", "");
  bru.setVar("farmerRefreshToken", "");
  bru.setVar("accessToken", "");
  bru.setVar("refreshToken", "");
  bru.setVar("activeRole", "");
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    if (data.user.role !== "farmer") throw new Error("Expected a farmer account; check the phone number.");
    bru.setVar("farmerAccessToken", data.accessToken);
    bru.setVar("farmerRefreshToken", data.refreshToken);
    bru.setVar("farmerId", data.user.id);
    bru.setVar("accessToken", data.accessToken);
    bru.setVar("refreshToken", data.refreshToken);
    bru.setVar("activeRole", "farmer");
  }
}

tests {
  test("Expected HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Successful API response", function () {
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Logs in an existing farmer account. Saves role-specific tokens and selects it as the active session. Set credentials in the Local environment. Tokens stay in runtime variables.
}
